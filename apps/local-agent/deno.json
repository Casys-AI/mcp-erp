{
  "name": "@casys/mcp-erp-local-agent",
  "version": "0.1.0",
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli.ts"
  },
  "tasks": {
    "agent": "deno run --allow-read --allow-net src/cli.ts",
    "check": "deno fmt --check . && deno lint . && deno check && deno test"
  },
  "imports": {
    "@casys/mcp-bridge": "jsr:@casys/mcp-bridge@^0.3.0",
    "@casys/mcp-bridge/adapters/network": "jsr:@casys/mcp-bridge@^0.3.0/adapters/network",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "compilerOptions": {
    "strict": true
  }
}
