{
  "name": "@casys/mcp-erp",
  "version": "0.1.0",
  "description": "ERP-agnostic MCP adapters. Drop-in adapter layer for ERPNext, Dolibarr, and more — designed to be embedded in a multi-tenant MCP server.",
  "exports": {
    ".": "./mod.ts",
    "./local-agent": "./apps/local-agent/src/mod.ts",
    "./local-agent/cli": "./apps/local-agent/src/cli.ts"
  },
  "imports": {
    "@casys/mcp-bridge/adapters/network": "../mcp-server/packages/bridge/src/adapters/network/mod.ts",
    "@casys/mcp-server": "jsr:@casys/mcp-server@^0.17.2",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "test": "deno test --allow-all"
  },
  "publish": {
    "include": [
      "mod.ts",
      "src/**/*.ts",
      "apps/local-agent/src/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "**/*_test.ts",
      "**/*.test.ts"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.window",
      "esnext"
    ]
  }
}
