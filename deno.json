{
  "name": "@casys/mcp-erp",
  "version": "0.1.0",
  "description": "ERP-agnostic MCP adapters. Drop-in adapter layer for ERPNext, Dolibarr, and more — designed to be embedded in a multi-tenant MCP server.",
  "exports": {
    ".": "./mod.ts",
    "./server": "./server.ts"
  },
  "imports": {
    "@casys/mcp-server": "jsr:@casys/mcp-server@^0.21.0",
    "@deno/dnt": "jsr:@deno/dnt@^0.41",
    "@std/assert": "jsr:@std/assert@^1",
    "esbuild": "npm:esbuild@^0.25"
  },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "serve": "deno run --allow-read --allow-net server.ts --http",
    "stdio": "deno run --allow-read --allow-net server.ts",
    "test": "deno test --allow-all"
  },
  "publish": {
    "include": [
      "mod.ts",
      "server.ts",
      "src/**/*.ts",
      "src/ui/dist/**/*.html",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "**/*_test.ts",
      "**/*.test.ts"
    ]
  },
  "exclude": [
    "dist-node",
    ".claude",
    ".serena"
  ],
  "fmt": {
    "exclude": [
      "src/ui/dist"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.window",
      "esnext"
    ]
  }
}
